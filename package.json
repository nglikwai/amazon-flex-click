{
  "name": "amazon-flex-slotter",
  "version": "1.0.0",
  "description": "Amazon Flex Slotter - Automated slot grabber for macOS",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dev:cli": "ts-node src/index.ts",
    "setup:dev": "ts-node src/setup.ts",
    "setup": "node ./dist/setup",
    "rebuild": "electron-rebuild -f -w @jitsi/robotjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.18",
    "@types/nodemailer": "^8.0.1",
    "desktop-screenshot": "^0.1.1",
    "nodemailer": "^9.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.34.4",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/screenshot-desktop": "^1.15.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.amazonflexslotter.app",
    "productName": "Amazon Flex Slotter",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  },
  "keywords": [
    "automation",
    "macos",
    "amazon-flex"
  ],
  "author": "",
  "license": "MIT"
}
